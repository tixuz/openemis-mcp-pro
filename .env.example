# ── OpenEMIS connection ───────────────────────────────────────────────────────

# Base URL of the OpenEMIS Core instance (trailing slash removed automatically)
OPENEMIS_BASE_URL=https://demo.openemis.org/core

# Shared API key — required. Used for every upstream login (env-default AND
# per-user). Get it from your OpenEMIS administrator.
OPENEMIS_API_KEY=your_api_key_here

# Env-default user — OPTIONAL and strongly discouraged in production.
#
# If set, callers who authenticate with the gateway bearer (OPENEMIS_AUTH_TOKEN)
# but never call /api/auth/login (REST) or openemis_login (MCP) will silently
# act as this user. Harmful for ChatGPT Custom Actions: ChatGPT cannot send the
# response-minted session token back on subsequent calls, so they all revert to
# THIS identity regardless of who the user logged in as.
#
# Leave unset → the server fails closed with a clear "call /api/auth/login
# first" error, which is the correct posture for any public deployment.
#
# OPENEMIS_USERNAME=admin
# OPENEMIS_PASSWORD=your_password_here

# Request timeout in milliseconds (default: 30000)
OPENEMIS_TIMEOUT_MS=30000

# ── Data paths (optional — defaults use the bundled data/ directory) ──────────

# Folder containing Domain-*.md curated notes used by openemis_discover.
# If absent, discovery degrades gracefully to keyword matching.
# OPENEMIS_VAULT_PATH=/path/to/vault

# JSONL manifest of all API endpoints (built by the companion mcp-openemis-gen tool).
# If absent, the server still works; discovery returns fewer results.
# OPENEMIS_MANIFEST_PATH=/path/to/manifest.jsonl

# Pre-computed grouped-manifest index (defaults to data/grouped-manifest.json).
# OPENEMIS_GROUPED_PATH=data/grouped-manifest.json

# ── Transport ─────────────────────────────────────────────────────────────────
#
# stdio  (default) — local subprocess for Claude Code / Cursor / Cline.
#                    Register with: claude mcp add openemis -- node dist/server.js
#
# http   — persistent HTTP server (Oracle Always Free, any VPS).
#           MCP clients connect by URL: http://<your-server>:<port>/mcp
#
# OPENEMIS_TRANSPORT=stdio

# Port for HTTP mode (default: 3000). Ignored in stdio mode.
# OPENEMIS_PORT=3000

# Bearer token clients must send as:  Authorization: Bearer <token>
# Leave empty only for localhost testing — always set this on a public server.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OPENEMIS_AUTH_TOKEN=your-secret-token-here

# Enable REST per-user login (POST /api/auth/login + /api/auth/logout).
# Default: off. Strongly recommended to leave off for any ChatGPT-facing
# deployment.
#
# When OFF (default):
#   - /api/auth/login and /api/auth/logout return HTTP 410 Gone.
#   - /openapi.json does not advertise these paths — ChatGPT importers never
#     see a REST login button that would leak a reusable session token into
#     the tool trace.
#   - The ONLY per-user authentication path is the MCP channel: connect to
#     /mcp and call the openemis_login tool. The MCP transport pins the
#     identity to the server-managed Mcp-Session-Id header and never hands
#     back a reusable bearer handle.
#
# Enable ONLY when you operate a trusted non-ChatGPT REST client (backend
# script, curl pipeline, bespoke integration) that can reliably propagate
# the minted session token per-request. ChatGPT Custom Actions CANNOT do
# this — they carry exactly one preconfigured Bearer, set at Action-import
# time, and cannot swap to a response-derived token.
#
# OPENEMIS_REST_LOGIN_ENABLED=false
